{
  "permissions": {
    "deny": [
      "Read(**/pii*)",
      "Read(**/*_Resume.pdf)",
      "Read(**/Resume.*)",
      "Read(**/*_filled.*)",
      "Read(**/*-filled.*)",
      "Read(**/private/**)"
    ],
    "allow": [
      "Bash(python3 .claude/skills/resume-ats-optimizer/scripts/odt_text.py shape *)",
      "Bash(python3 .claude/skills/resume-ats-optimizer/scripts/odt_text.py doctor *)",
      "Bash(python3 .claude/skills/resume-ats-optimizer/scripts/odt_text.py status *)",
      "Bash(python3 .claude/skills/resume-ats-optimizer/scripts/odt_text.py extract *)",
      "Bash(python3 .claude/skills/resume-ats-optimizer/scripts/odt_text.py budget *)",
      "Bash(python3 .claude/skills/resume-ats-optimizer/scripts/odt_text.py match *)",
      "Bash(python3 .claude/skills/resume-ats-optimizer/scripts/odt_text.py check *)",
      "Bash(python3 .claude/skills/resume-ats-optimizer/scripts/odt_text.py split *)",
      "Bash(python3 .claude/skills/resume-ats-optimizer/scripts/odt_text.py name *)",
      "Bash(python3 .claude/skills/resume-ats-optimizer/scripts/odt_text.py stage *)",
      "Bash(python3 .claude/skills/resume-ats-optimizer/scripts/odt_text.py apply *)",
      "Bash(python3 .claude/skills/resume-ats-optimizer/scripts/odt_text.py fill *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/hooks/guard.sh\"",
            "timeout": 10,
            "statusMessage": "Checking for PII access"
          }
        ]
      }
    ]
  }
}
