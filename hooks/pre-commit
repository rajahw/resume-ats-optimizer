#!/bin/sh
# Interpreter shim for the commit-time identity guard - see hooks/guard.sh for
# why naming `python3` outright is not enough on Windows.
#
# A guard that cannot run blocks the commit rather than waving it through: git
# history is permanent, and a resume committed with real values in it cannot be
# un-published by a later delete.
set -u

dir="$(dirname "$0")"

for py in python3 python py; do
    if command -v "$py" >/dev/null 2>&1 && "$py" -c "" >/dev/null 2>&1; then
        exec "$py" "$dir/pre-commit.py" "$@"
    fi
done

echo "pre-commit: no working Python interpreter found (tried python3, python, py)." >&2
echo "The identity guard cannot run, so this commit is blocked." >&2
echo "Install Python 3, or bypass deliberately with: git commit --no-verify" >&2
exit 1
